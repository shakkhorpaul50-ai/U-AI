@{
    ViewData["Title"] = "Welcome";
}
<div class="auth-shell">
    <div class="auth-card wide">
        <div class="auth-brand"><img src="~/img/logo.svg" alt="U-AI logo" class="auth-logo" asp-append-version="true" /></div>
        <h1 class="auth-title">Five modes, one assistant</h1>
        <p class="muted">
            Five modes, one account, free to use. No card, no setup.
        </p>
        <div class="mode-grid">
            <div class="mode-tile"><strong>Chat</strong><span>General questions</span></div>
            <div class="mode-tile"><strong>Creative</strong><span>Stories and prose</span></div>
            <div class="mode-tile"><strong>Wifu</strong><span>Maya, Bengali companion</span></div>
            <div class="mode-tile"><strong>S-Paul</strong><span>Bengali companion</span></div>
            <div class="mode-tile"><strong>Code</strong><span>Snippets and debugging</span></div>
        </div>
        <a class="btn btn-accent w-100 mt-4" asp-controller="Account" asp-action="Login">Sign in</a>
        <a class="btn btn-ghost w-100 mt-2" asp-controller="Account" asp-action="Register">Create an account</a>
        <p class="credit">Developed by <a href="https://www.facebook.com/profile.php?id=100023479221437" target="_blank" rel="noopener">Shakkhor Paul</a></p>
    </div>
</div>
